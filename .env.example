# Required native bindings on the sole Dot cloud owner. Reference only; not auto-loaded.
# Every personal variable must be supplied, including explicit null/[] where documented.
# Fixed runtime/backend/execution/update policy are defined in Python, not configurable.
# Never complete this tracked reference with actual values. Native settings only.
# Required personal configuration:
# SQUAD_PROFILE_ID=<string; profile_id>
# SQUAD_TIMEZONE=<string; timezone>
# SQUAD_JURISDICTION=<string; jurisdiction>
# SQUAD_BASE_CURRENCY=<string; base_currency>
# SQUAD_STARTING_CASH=<string; starting_cash>
# SQUAD_MONEY_DECIMALS=<integer; money_decimals>
# SQUAD_MAX_TRADE_IDEAS_PER_DAY=<integer; max_trade_ideas_per_day>
# SQUAD_MAX_CANDIDATES_PER_DAY=<integer; max_candidates_per_day>
# SQUAD_ROUND_TRIP_COST_BPS=<number; round_trip_cost_bps>
# SQUAD_BROKERAGE_NAME=<string; brokerage.name>
# SQUAD_BROKERAGE_CONSTRAINTS=<string; brokerage.constraints>
# SQUAD_WORKER_MODEL=<string; worker.model>
# SQUAD_WORKER_REASONING_EFFORT=<string; worker.reasoning_effort>
# SQUAD_SPENDING_ADDITIONAL_SERVICES_BUDGET=<string; spending.additional_services_budget>
# SQUAD_NOTIFICATION_DESTINATION=<string; notification.destination>
# SQUAD_INSTRUMENTS=<JSON array; instruments>
# SQUAD_RESEARCH_UNIVERSE=<JSON array; research_universe>
# SQUAD_STORAGE_DATABASE_PATH=<string; storage.database_path>
# SQUAD_STORAGE_BACKUP_DIRECTORY=<string; storage.backup_directory>
# SQUAD_STORAGE_BACKUP_INTERVAL_HOURS=<integer; storage.backup_interval_hours>
# SQUAD_STORAGE_BACKUP_RETENTION_DAYS=<integer; storage.backup_retention_days>
# SQUAD_STORAGE_RUNTIME_ID=<string; storage.runtime_id>
# SQUAD_STORAGE_DECISION_ACCEPTED=<boolean; storage.decision_accepted>
# SQUAD_STORAGE_KNOWLEDGE_PATH=<string; storage.knowledge_path>
# SQUAD_STORAGE_CLOUD_BACKUP_FOLDER_ID=<string; storage.cloud_backup.folder_id>
# SQUAD_STORAGE_CLOUD_BACKUP_MAX_BYTES=<integer; storage.cloud_backup.max_bytes>
# SQUAD_STORAGE_CLOUD_BACKUP_MAX_ARCHIVE_BYTES=<integer; storage.cloud_backup.max_archive_bytes>
# SQUAD_SCHEDULES_MONITOR_ENABLED=<boolean; schedules.monitor.enabled>
# SQUAD_SCHEDULES_MONITOR_RRULE=<string; schedules.monitor.rrule>
# SQUAD_SCHEDULES_RESEARCH_ENABLED=<boolean; schedules.research.enabled>
# SQUAD_SCHEDULES_RESEARCH_RRULE=<string; schedules.research.rrule>
# SQUAD_SCHEDULES_RECONCILE_ENABLED=<boolean; schedules.reconcile.enabled>
# SQUAD_SCHEDULES_RECONCILE_RRULE=<string; schedules.reconcile.rrule>
# SQUAD_GITOPS_REF=<string; gitops.ref>
# Required vault bindings for renewable Google Drive OAuth:
# SQUAD_GOOGLE_REFRESH_TOKEN=<secret>
# SQUAD_GOOGLE_CLIENT_ID=<runtime secret binding>
# SQUAD_GOOGLE_CLIENT_SECRET=<secret>
# Execution bindings supplied by onboarding/native task setup:
# SQUAD_REPO=/actual/checkout
# SQUAD_PYTHON=/actual/venv/bin/python
# SQUAD_TASK_KEY=<actual native logical task key>
