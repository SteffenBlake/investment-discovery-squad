# Copy to .env in checkout root. Fill blank values; review proposed defaults.
# Shell syntax: quote text and JSON. Onboarding supplies exact field names/types.

# User choices; reuse facts already supplied.
SQUAD_PROFILE_ID=investment-discovery
SQUAD_TIMEZONE=
SQUAD_JURISDICTION=
SQUAD_BASE_CURRENCY=
SQUAD_RISK_PREFERENCES=
SQUAD_BROKERAGE_NAME=
SQUAD_BROKERAGE_CONSTRAINTS=
# Fill fees/cost estimate from reviewed public broker and market terms.
SQUAD_BROKERAGE_ENTRY_FEE_FIXED=
SQUAD_BROKERAGE_ENTRY_FEE_PER_UNIT=
SQUAD_ROUND_TRIP_COST_BPS=
# Populate allowed instruments from reviewed investment scope.
SQUAD_INSTRUMENTS='[]'
SQUAD_RESEARCH_UNIVERSE='[]'

# Daily work ceilings; host model defaults; extra paid services require review.
SQUAD_MAX_CANDIDATES_PER_DAY=1
SQUAD_WORKER_MODEL=null
SQUAD_WORKER_REASONING_EFFORT=null
SQUAD_SPENDING_ADDITIONAL_SERVICES_BUDGET=0
SQUAD_NOTIFICATION_DESTINATION=chatgpt

# Load from checkout root. Fill approved release/tag and returned Dot environment ID.
SQUAD_REPO="$PWD"
SQUAD_PYTHON="$SQUAD_REPO/.venv/bin/python"
SQUAD_GITOPS_REF=
SQUAD_STORAGE_RUNTIME_ID=
# Private runtime data outside checkout; adjust if computer's storage requires it.
SQUAD_STORAGE_DATABASE_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/investment-discovery/$SQUAD_PROFILE_ID/data/ledger.sqlite3"
SQUAD_STORAGE_KNOWLEDGE_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/investment-discovery/$SQUAD_PROFILE_ID/data/knowledge.lbdb"
SQUAD_STORAGE_BACKUP_DIRECTORY="${XDG_DATA_HOME:-$HOME/.local/share}/investment-discovery/$SQUAD_PROFILE_ID/backups"
SQUAD_LADYBUG_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/investment-discovery/$SQUAD_PROFILE_ID/ladybug-runtime"
SQUAD_STORAGE_BACKUP_INTERVAL_HOURS=24
SQUAD_STORAGE_CLOUD_BACKUP_FOLDER_ID=
# Proposed allowance: 1 GiB current folder contents, 256 MiB/archive.
SQUAD_STORAGE_CLOUD_BACKUP_MAX_BYTES=1073741824
SQUAD_STORAGE_CLOUD_BACKUP_MAX_ARCHIVE_BYTES=268435456
# Set true after user accepts concrete storage proposal.
SQUAD_STORAGE_DECISION_ACCEPTED=false

# Proposed cadences. Review timezone, first-run time and enabled choices.
SQUAD_SCHEDULES_MONITOR_ENABLED=true
SQUAD_SCHEDULES_MONITOR_RRULE='RRULE:FREQ=DAILY'
SQUAD_SCHEDULES_RESEARCH_ENABLED=true
SQUAD_SCHEDULES_RESEARCH_RRULE='RRULE:FREQ=DAILY'
SQUAD_SCHEDULES_RECONCILE_ENABLED=true
SQUAD_SCHEDULES_RECONCILE_RRULE='RRULE:FREQ=WEEKLY'
